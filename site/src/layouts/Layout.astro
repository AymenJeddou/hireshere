---
import "@fontsource/roboto/400.css";
import "@fontsource/roboto/500.css";
import "@fontsource/roboto/700.css";
import "../styles/global.css";
import "../styles/components.css";
import { site } from "../data";
import { href, type Lang, LANGS, NATIVE, type Page, tr } from "../i18n";

interface Props {
  lang: Lang;
  page: Page;
  title: string;
  description: string;
  country?: string;
  noindex?: boolean;
}
const { lang, page, title, description, country, noindex = false } = Astro.props;
const others = LANGS.filter((l) => l !== lang);
const canonical = new URL(href(lang, page, country), Astro.site).toString();
const alternate = (l: Lang) => new URL(href(l, page, country), Astro.site).toString();
---

<!doctype html>
<html lang={lang} dir={lang === "ar" ? "rtl" : "ltr"}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    {noindex && <meta name="robots" content="noindex" />}
    <meta name="theme-color" content="#0b3a53" />
    <link rel="canonical" href={canonical} />
    <link rel="alternate" hreflang="en" href={alternate("en")} />
    <link rel="alternate" hreflang="fr" href={alternate("fr")} />
    <link rel="alternate" hreflang="ar" href={alternate("ar")} />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonical} />
    <meta property="og:site_name" content={site.product} />
    <meta property="og:image" content={new URL("/og.png", Astro.site).toString()} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:locale" content={{ en: "en_US", fr: "fr_FR", ar: "ar_AR" }[lang]} />
    <meta name="twitter:card" content="summary_large_image" />
  </head>
  <body>
    <a class="skip" href="#main">{tr(lang, "skip")}</a>
    <header class="site-header">
      <div class="wrap">
        <a class="brand" href={href(lang, "home")}><span class="brand-mark" aria-hidden="true"></span>{site.product}</a>
        <nav class="main-nav" aria-label={tr(lang, "nav_main")}>
          {
            ([["search", "nav_find"], ["companies", "nav_companies"], ["guide", "nav_guide"], ["how", "nav_how"]] as const).map(([p, k]) => (
              <a href={href(lang, p)} aria-current={page === p || (p === "search" && page === "job") ? "page" : undefined}>
                {tr(lang, k)}
              </a>
            ))
          }
        </nav>
        <div class="header-links">
          <a class="saved-link" href={href(lang, "saved")} aria-current={page === "saved" ? "page" : undefined}>
            <svg class="icon" viewBox="0 0 24 24" aria-hidden="true"><path d="M12 3.5l2.6 5.3 5.9.9-4.3 4.1 1 5.8L12 16.9 6.8 19.6l1-5.8L3.5 9.7l5.9-.9z" /></svg>
            <span class="label">{tr(lang, "my_jobs")}</span>
          </a>
          <span class="lang-switch">
            {
              others.map((l) => (
                <a href={href(l, page, country)} hreflang={l} lang={l} aria-label={NATIVE[l].name}>
                  {NATIVE[l].short}
                </a>
              ))
            }
          </span>
        </div>
      </div>
    </header>

    <main id="main">
      <slot />
    </main>

    <footer class="site-footer">
      <div class="wrap">
        <p class="disclaimer">{tr(lang, "footer_disclaimer")}</p>
        <p>{tr(lang, "footer_data")}</p>
        <nav aria-label="Footer">
          <a href={href(lang, "how")}>{tr(lang, "nav_how")}</a>
          <a href={href(lang, "guide")}>{tr(lang, "nav_guide")}</a>
          <a href={href(lang, "companies")}>{tr(lang, "nav_companies")}</a>
          <a href={href(lang, "sources")}>{tr(lang, "nav_sources")}</a>
          <a href={href(lang, "employers")}>{tr(lang, "nav_employers")}</a>
          {others.map((l) => <a href={href(l, page, country)} hreflang={l} lang={l}>{NATIVE[l].name}</a>)}
          <a href={`mailto:${site.contact}`}>{site.contact}</a>
        </nav>
        <p>© {new Date(site.updated).getUTCFullYear()} {site.product} · {site.domain}</p>
      </div>
    </footer>
    {
      page === "search" && (
        <script is:inline>
          // Switching language keeps the current filters.
          document.querySelectorAll("a[hreflang]").forEach((a) => a.addEventListener("click", () => (a.search = location.search)));
        </script>
      )
    }
  </body>
</html>
