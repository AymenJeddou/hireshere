---
import "@fontsource-variable/public-sans";
import "../styles/global.css";
import { countries, countryName, site } from "../data";
import { href, type Lang, LANGS, NATIVE, type Page, tr } from "../i18n";

interface Props {
  lang: Lang;
  page: Page;
  title: string;
  description: string;
  country?: string;
}
const { lang, page, title, description, country } = Astro.props;
const others = LANGS.filter((l) => l !== lang);
const canonical = new URL(href(lang, page, country), Astro.site).toString();
const alternate = (l: Lang) => new URL(href(l, page, country), Astro.site).toString();
---

<!doctype html>
<html lang={lang} dir={lang === "ar" ? "rtl" : "ltr"}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="theme-color" content="#0e2a47" />
    <link rel="canonical" href={canonical} />
    <link rel="alternate" hreflang="en" href={alternate("en")} />
    <link rel="alternate" hreflang="fr" href={alternate("fr")} />
    <link rel="alternate" hreflang="ar" href={alternate("ar")} />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonical} />
    <meta property="og:site_name" content={site.product} />
    <meta property="og:image" content={new URL("/og.png", Astro.site).toString()} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:locale" content={{ en: "en_US", fr: "fr_FR", ar: "ar_AR" }[lang]} />
    <meta name="twitter:card" content="summary_large_image" />
  </head>
  <body>
    <a class="skip" href="#main">{tr(lang, "skip")}</a>
    <header class="site-header">
      <div class="wrap">
        <a class="brand" href={href(lang, "home")}>
          <svg width="22" height="22" viewBox="0 0 22 22" aria-hidden="true">
            <circle cx="11" cy="11" r="10" fill="none" stroke="#b9c7da" stroke-width="1.6"></circle>
            <circle cx="11" cy="11" r="5.5" fill="#f2b705"></circle>
          </svg>
          {site.product}
        </a>
        <nav class="country-nav" aria-label={tr(lang, "nav_countries")}>
          {
            countries.map((c) => (
              <a
                href={href(lang, "country", c.code)}
                aria-current={country === c.code ? "page" : undefined}
                lang={lang}
              >
                <span class="name">{countryName(c, lang)}</span>
                <span class="code" aria-hidden="true">{c.code}</span>
              </a>
            ))
          }
        </nav>
        <div class="header-links">
          <a class="text" href={href(lang, "saved")} aria-current={page === "saved" ? "page" : undefined}
            >★ <span class="my-jobs-text">{tr(lang, "my_jobs")}</span></a
          >
          <a class="text" href={href(lang, "how")} aria-current={page === "how" ? "page" : undefined}
            >{tr(lang, "nav_how")}</a
          >
          {
            others.map((l) => (
              <a class="lang-switch" href={href(l, page, country)} hreflang={l} lang={l} aria-label={NATIVE[l].name}>
                <span class="long" aria-hidden="true">{NATIVE[l].name}</span>
                <span class="short" aria-hidden="true">{NATIVE[l].short}</span>
              </a>
            ))
          }
        </div>
      </div>
    </header>

    <main id="main">
      <slot />
    </main>

    <footer class="site-footer">
      <div class="wrap">
        <p class="disclaimer">{tr(lang, "footer_disclaimer")}</p>
        <p>{tr(lang, "footer_data")}</p>
        <nav aria-label="Footer">
          <a href={href(lang, "how")}>{tr(lang, "nav_how")}</a>
          <a href={href(lang, "guide")}>{tr(lang, "nav_guide")}</a>
          <a href={href(lang, "companies")}>{tr(lang, "nav_companies")}</a>
          <a href={href(lang, "sources")}>{tr(lang, "nav_sources")}</a>
          <a href={href(lang, "employers")}>{tr(lang, "nav_employers")}</a>
          {others.map((l) => <a href={href(l, page, country)} hreflang={l} lang={l}>{NATIVE[l].name}</a>)}
          <a href={`mailto:${site.contact}`}>{site.contact}</a>
        </nav>
        <p>© {new Date(site.updated).getUTCFullYear()} {site.product} · {site.domain}</p>
      </div>
    </footer>
  </body>
</html>
