---
// Job page shell, one per language. functions/_job.js fills the placeholders and the slot
// with the job from its detail shard, so 8,000 jobs x 3 languages are not prerendered.
import Layout from "../../layouts/Layout.astro";
import { site } from "../../data";
import type { Lang } from "../../i18n";

export function getStaticPaths() {
  return ["en", "fr", "ar"].map((lang) => ({ params: { lang } }));
}
const lang = Astro.params.lang as Lang;
---

<Layout lang={lang} page="job" country="__SLUG__" title={`__TITLE__ | ${site.product}`} description="__DESC__" noindex>
  <div id="job-slot"></div>
</Layout>

<script>
  import { groupFor } from "../../scripts/cards";
  import { initSaveButtons } from "../../scripts/saved";
  import { colourMap, loadWorld } from "../../scripts/worldmap";
  import { jobMeta, jobPage } from "../../scripts/jobpage";
  import meta from "../../data/meta.json";
  import type { Lang } from "../../i18n";

  // Normally functions/_job.js fills the slot on the server. When Pages Functions are off
  // (free daily limit used up), _redirects serves this shell as-is: render the job here.
  const slot = document.getElementById("job-slot");
  if (slot) {
    const lang = (document.documentElement.lang || "en") as Lang;
    const slug = location.pathname.split("/").filter(Boolean).pop() ?? "";
    const q = new URLSearchParams(location.search).get("c")?.toUpperCase();
    const saved = document.cookie.match(/(?:^|;\s*)hh_country=([A-Z]{2})/)?.[1];
    const code = [q, saved].find((c) => c && c in meta.world) ?? "";
    const shard = /^[a-z0-9-]{1,80}-[0-9a-f]{6}$/.test(slug)
      ? await fetch(`/data/j/${slug.slice(-6, -4)}.json`).then((r) => (r.ok ? r.json() : {})).catch(() => ({}))
      : {};
    const job = shard[slug];
    if (job) {
      const { title, description } = jobMeta(job, lang, code, meta as never);
      document.title = `${title} | ${meta.product}`;
      document.querySelector('meta[name="description"]')?.setAttribute("content", description);
      slot.outerHTML = jobPage(job, lang, code, meta as never);
    } else {
      location.replace(`/closed/${lang}?from=${encodeURIComponent(slug)}`);
    }
  }
  init();

  function init() {
  initSaveButtons();
  // Who can apply: every country coloured by its verdict, the visitor in coral.
  const map = document.querySelector<HTMLElement>("[data-whomap]");
  if (map) {
    const groups = (JSON.parse(map.dataset.g ?? "[]") as [string, string[] | "*"][]).map(([v, c]) => ({ v, c }));
    const you = map.dataset.you ?? "";
    const FILL: Record<string, string> = { eligible: "#157a43", likely: "#e0a85a", unclear: "#c9c3b8" };
    loadWorld().then((svg) =>
      colourMap(map, svg, (c) => ({ fill: c === you ? "#ff7a59" : FILL[groupFor(groups, c)?.v ?? ""] ?? "#e4e0d8" })),
    );
  }
  const f = document.querySelector<HTMLFormElement>(".report-form");
  if (f) {
    const gs = (JSON.parse(f.dataset.g ?? "[]") as [string, string[] | "*"][]).map(([v, c]) => ({ v, c }));
    const country = f.elements.namedItem("country") as HTMLSelectElement;
    country.addEventListener("change", () => {
      (f.elements.namedItem("verdict") as HTMLInputElement).value = groupFor(gs, country.value)?.v ?? "not_eligible";
    });
    f.addEventListener("submit", async (ev) => {
      ev.preventDefault();
      if (!f.reportValidity()) return;
      const button = f.querySelector<HTMLButtonElement>("button[type=submit]")!;
      const msg = f.querySelector<HTMLElement>(".form-msg")!;
      const label = button.textContent;
      button.disabled = true;
      button.textContent = button.dataset.sending ?? "";
      try {
        const res = await fetch(f.action, { method: "POST", body: new FormData(f) });
        if (!res.ok) throw new Error(String(res.status));
        msg.className = "form-msg ok";
        msg.textContent = button.dataset.ok ?? "";
        f.querySelectorAll("fieldset, label.field, button").forEach((el) => el.remove());
      } catch {
        msg.className = "form-msg err";
        msg.textContent = button.dataset.err ?? "";
        button.disabled = false;
        button.textContent = label;
      }
    });
  }
  }
</script>
