---
import CompanyPage from "../../../components/CompanyPage.astro";
import Layout from "../../../layouts/Layout.astro";
import { companies, site } from "../../../data";
import { tr } from "../../../i18n";

export function getStaticPaths() {
  return Object.keys(companies).map((key) => ({ params: { key } }));
}
const { key } = Astro.params as { key: string };
const lang = "fr";
const co = companies[key];
const vars = { company: co.name, product: site.product, n: co.n };
---

<Layout
  lang={lang}
  page="company"
  country={key}
  title={tr(lang, "company_meta", vars)}
  description={tr(lang, "company_intro", vars)}
>
  <CompanyPage companyKey={key} lang={lang} />
</Layout>
