---
import CompanyPage from "../../components/CompanyPage.astro";
import Layout from "../../layouts/Layout.astro";
import { allJobs, companyJobs, site } from "../../data";
import { tr } from "../../i18n";

export function getStaticPaths() {
  return [...new Set(allJobs.map((j) => j.company_key))].map((key) => ({ params: { key } }));
}
const { key } = Astro.params as { key: string };
const lang = "en";
const jobs = companyJobs(key);
const vars = { company: jobs[0].company, product: site.product, n: jobs.length };
---

<Layout
  lang={lang}
  page="company"
  country={key}
  title={tr(lang, "company_meta", vars)}
  description={tr(lang, "company_intro", vars)}
>
  <CompanyPage companyKey={key} lang={lang} />
</Layout>
