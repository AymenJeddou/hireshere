---
// The icon line under a job title: place, contract, level, salary (and when it was found).
import { type JobRecord, salaryText, site } from "../data";
import { labels, type Lang, tr } from "../i18n";

interface Props {
  job: JobRecord;
  lang: Lang;
  found?: boolean;
}
const { job, lang, found = false } = Astro.props;
const place = job.scope || job.location.split(/;\s*/).slice(0, 2).join(", ");
const contract =
  job.engagement !== "unclear" ? labels.engagement[job.engagement as keyof typeof labels.engagement]?.[lang] : "";
const level = job.seniority !== "unclear" ? labels.seniority[job.seniority as keyof typeof labels.seniority]?.[lang] : "";
const salary = salaryText(job.salary, lang);
const days = Math.max(0, Math.floor((Date.parse(site.updated) - Date.parse(job.seen_at)) / 86400000));
const when = days === 0 ? tr(lang, "found_today") : days === 1 ? tr(lang, "found_1") : tr(lang, "found_ago", { n: days });
const P = {
  place: "M12 21s-7-6.1-7-11a7 7 0 0 1 14 0c0 4.9-7 11-7 11zM12 12.5a2.5 2.5 0 1 0 0-5 2.5 2.5 0 0 0 0 5z",
  contract: "M7 3h10a2 2 0 0 1 2 2v14a2 2 0 0 1-2 2H7a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2zM9 8h6M9 12h6M9 16h4",
  level: "M4 20V14M10 20V9M16 20V4",
  salary: "M5 6h14a2 2 0 0 1 2 2v8a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2zM12 14.5a2.5 2.5 0 1 0 0-5 2.5 2.5 0 0 0 0 5z",
  when: "M12 21a9 9 0 1 0 0-18 9 9 0 0 0 0 18zM12 7v5l3 2",
};
const items = [
  ["place", place],
  ["contract", contract],
  ["level", level],
  ["salary", salary],
  ...(found ? [["when", when]] : []),
].filter(([, v]) => v) as [keyof typeof P, string][];
---

<ul class="card-info">
  {
    items.map(([k, v]) => (
      <li>
        <svg class="icon" viewBox="0 0 24 24" aria-hidden="true"><path d={P[k]} /></svg>
        {k === "when" ? <time datetime={job.seen}>{v}</time> : v}
      </li>
    ))
  }
</ul>
