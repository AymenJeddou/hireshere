---
import { companies, companyJobs, countryName, site, world } from "../data";
import { href, labels, type Lang, tr } from "../i18n";
import Avatar from "./Avatar.astro";

interface Props {
  companyKey: string;
  lang: Lang;
}
const { companyKey, lang } = Astro.props;
const co = companies[companyKey];
const jobs = companyJobs(companyKey);
const names = Object.fromEntries(world(lang).map((c) => [c.code, c.name]));
const contracts = [...new Set(jobs.map((j) => j.engagement).filter((e) => e !== "unclear"))];
// Every level the company is hiring for, junior to lead, with how many openings each.
const levels = Object.keys(labels.seniority)
  .map((s) => [s, jobs.filter((j) => j.seniority === s).length] as const)
  .filter(([s, n]) => n > 0 && s !== "unclear");
---

<div class="wrap company-page" data-company={companyKey} data-lang={lang} data-updated={site.updated} data-names={JSON.stringify(names)}>
  <header class="cp-head">
    <Avatar name={co.name} companyKey={companyKey} size={64} />
    <div>
      <h1>{co.name}</h1>
      <p class="sub">{tr(lang, "company_intro", { n: co.n, company: co.name })}</p>
      {
        co.website && (
          <p>
            <a href={co.website} rel="noopener" target="_blank">
              {tr(lang, "website")}: {new URL(co.website).hostname.replace(/^www\./, "")}
            </a>
          </p>
        )
      }
    </div>
  </header>
  {
    co.named.length > 0 && (
      <p class="cp-hires">
        {tr(lang, "hires_here", { countries: co.named.map((c) => countryName(site.world[c as keyof typeof site.world], lang)).join(", ") })}
      </p>
    )
  }
  {
    contracts.length > 0 && (
      <p class="cp-contracts">
        {tr(lang, "contracts")}: {contracts.map((e) => labels.engagement[e as keyof typeof labels.engagement]?.[lang]).join(", ")}
      </p>
    )
  }

  {
    levels.length > 0 && (
      <p class="cp-contracts">
        {tr(lang, "levels")}: {levels.map(([s, n]) => `${labels.seniority[s as keyof typeof labels.seniority]?.[lang]} (${n})`).join(", ")}
      </p>
    )
  }

  <h2 class="cp-h2">{tr(lang, "jobs_at", { company: co.name })}</h2>
  <!-- Without JavaScript: plain links. The script renders cards for the visitor's country. -->
  <ol class="cards plain-links" data-cards>
    {
      jobs.map((j) => (
        <li>
          <a href={href(lang, "job", j.slug)}>{j.title}</a>
        </li>
      ))
    }
  </ol>
</div>

<script>
  import type { Lang } from "../i18n";
  import { card, loadJobs, verdictsFor } from "../scripts/cards";
  import { visitorCountry } from "../scripts/country";
  import { initSaveButtons } from "../scripts/saved";

  const root = document.querySelector<HTMLElement>("[data-company]")!;
  const list = root.querySelector<HTMLOListElement>("[data-cards]")!;
  const names = JSON.parse(root.dataset.names ?? "{}");
  const lang = root.dataset.lang as Lang;
  Promise.all([loadJobs(lang), visitorCountry((c) => c in names)]).then(([all, code]) => {
    // Jobs open to the visitor's country first, newest first within each.
    const open = (j: (typeof all)[number]) => (code && verdictsFor(j.groups, code).length ? 0 : 1);
    const jobs = all.filter((j) => j.company_key === root.dataset.company).sort((a, b) => open(a) - open(b));
    if (!jobs.length) return;
    list.classList.remove("plain-links");
    list.innerHTML = jobs.map((j) => card(j, { lang, code, names, updated: root.dataset.updated ?? "" })).join("");
    initSaveButtons(list);
  });
</script>

<style>
  .company-page {
    padding-block: var(--space-6);
  }
  .cp-head {
    display: flex;
    gap: var(--space-4);
    align-items: flex-start;
    margin-bottom: var(--space-4);
  }
  .cp-head h1 {
    font-size: var(--step-3);
  }
  .cp-head .sub {
    color: var(--ink-2);
    margin: var(--space-2) 0;
  }
  .cp-hires {
    color: var(--go);
    font-weight: 600;
  }
  .cp-contracts {
    color: var(--ink-2);
    font-size: var(--step-0);
    margin-top: var(--space-2);
  }
  .cp-h2 {
    font-size: var(--step-2);
    margin: var(--space-6) 0 var(--space-3);
  }
</style>
