---
import { jobs, site, totalBoards } from "../data";
import { href, type Lang, LOCALE, tr } from "../i18n";
import SearchBand from "./SearchBand.astro";

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const num = (n: number) => n.toLocaleString(LOCALE[lang]);
const steps = [
  ["home_how_1_t", "home_how_1"],
  ["home_how_2_t", "home_how_2"],
  ["home_how_3_t", "home_how_3"],
] as const;
---

<SearchBand lang={lang} title={tr(lang, "home_title")} sub={tr(lang, "home_lede")} popular />

<div class="wrap home">
  <div class="stats">
    <div class="stat"><b>{num(site.jobs)}</b><span>{tr(lang, "stat_jobs")}</span></div>
    <div class="stat"><b>{num(totalBoards())}</b><span>{tr(lang, "stat_companies")}</span></div>
    <div class="stat"><b>{num(site.open_jobs)}</b><span>{tr(lang, "stat_postings")}</span></div>
  </div>

  <section class="sec" aria-labelledby="latest">
    <h2 id="latest">{tr(lang, "latest_jobs")}</h2>
    <!-- Without JavaScript: plain links. The script shows the latest jobs open to the visitor's country. -->
    <ol class="cards plain-links" data-latest data-lang={lang} data-updated={site.updated}>
      {
        jobs.slice(0, 4).map((j) => (
          <li>
            <a href={href(lang, "job", j.slug)}>{j.title}</a> · {j.company}
          </li>
        ))
      }
    </ol>
    <p class="more-link"><a class="btn btn-secondary" href={href(lang, "search")}>{tr(lang, "see_all_n", { n: num(site.jobs) })}</a></p>
  </section>

  <section class="sec" aria-labelledby="how">
    <h2 id="how">{tr(lang, "home_how_title")}</h2>
    <ol class="howgrid">
      {
        steps.map(([title, body]) => (
          <li class="panel">
            <h3>{tr(lang, title)}</h3>
            <p>{tr(lang, body)}</p>
          </li>
        ))
      }
    </ol>
    <p class="more-link"><a href={href(lang, "how")}>{tr(lang, "home_more")}</a></p>
  </section>
</div>

<script>
  import type { Lang } from "../i18n";
  import { card, groupFor, loadJobs } from "../scripts/cards";
  import { remember, visitorCountry } from "../scripts/country";
  import { initSaveButtons } from "../scripts/saved";

  const list = document.querySelector<HTMLOListElement>("[data-latest]")!;
  const sel = document.querySelector<HTMLSelectElement>("[data-searchbar] select[name=c]")!;
  const names = Object.fromEntries([...sel.options].filter((o) => o.value).map((o) => [o.value, o.text]));
  const lang = list.dataset.lang as Lang;
  sel.addEventListener("change", () => remember(sel.value));
  Promise.all([loadJobs(lang), visitorCountry((c) => c in names)]).then(([jobs, code]) => {
    sel.value = code;
    // Latest jobs with a verbatim quote open or likely open here, one per company, newest first.
    const seen = new Set<string>();
    const latest = jobs
      .filter((j) => {
        const g = code ? groupFor(j.groups, code) : j.groups[0];
        return j.quote && g && (g.v === "eligible" || g.v === "likely");
      })
      .filter((j) => !seen.has(j.company_key) && seen.add(j.company_key))
      .slice(0, 4);
    if (!latest.length) return;
    list.classList.remove("plain-links");
    list.innerHTML = latest.map((j) => card(j, { lang, code, names, updated: list.dataset.updated ?? "" })).join("");
    initSaveButtons(list);
  });
</script>

<style>
  .more-link {
    margin-top: var(--space-4);
  }
</style>
