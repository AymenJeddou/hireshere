---
import { allJobs, site, totalBoards } from "../data";
import { href, type Lang, LOCALE, tr } from "../i18n";
import JobCard from "./JobCard.astro";
import SearchBand from "./SearchBand.astro";

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const open = allJobs.filter((j) => Object.values(j.verdicts).some((x) => x.v !== "unclear"));
// Latest open jobs with a verbatim quote, one per company, newest first.
const seen = new Set<string>();
const latest = [...open]
  .filter((j) => j.quote && j.confidence === "high")
  .sort((a, b) => b.seen_at.localeCompare(a.seen_at))
  .filter((j) => !seen.has(j.company_key) && seen.add(j.company_key))
  .slice(0, 4);
const num = (n: number) => n.toLocaleString(LOCALE[lang]);
const steps = [
  ["home_how_1_t", "home_how_1"],
  ["home_how_2_t", "home_how_2"],
  ["home_how_3_t", "home_how_3"],
] as const;
---

<SearchBand lang={lang} title={tr(lang, "home_title")} sub={tr(lang, "home_lede")} popular />

<div class="wrap home">
  <div class="stats">
    <div class="stat"><b>{num(open.length)}</b><span>{tr(lang, "stat_jobs")}</span></div>
    <div class="stat"><b>{num(totalBoards())}</b><span>{tr(lang, "stat_companies")}</span></div>
    <div class="stat"><b>{num(site.open_jobs)}</b><span>{tr(lang, "stat_postings")}</span></div>
  </div>

  <section class="sec" aria-labelledby="latest">
    <h2 id="latest">{tr(lang, "latest_jobs")}</h2>
    <ol class="cards">
      {latest.map((job) => <JobCard job={job} lang={lang} />)}
    </ol>
    <p class="more-link"><a class="btn btn-secondary" href={href(lang, "search")}>{tr(lang, "see_all_n", { n: num(open.length) })}</a></p>
  </section>

  <section class="sec" aria-labelledby="how">
    <h2 id="how">{tr(lang, "home_how_title")}</h2>
    <ol class="howgrid">
      {
        steps.map(([title, body]) => (
          <li class="panel">
            <h3>{tr(lang, title)}</h3>
            <p>{tr(lang, body)}</p>
          </li>
        ))
      }
    </ol>
    <p class="more-link"><a href={href(lang, "how")}>{tr(lang, "home_more")}</a></p>
  </section>
</div>

<style>
  .more-link {
    margin-top: var(--space-4);
  }
</style>

<script>
  import { initSaveButtons } from "../scripts/saved";
  initSaveButtons();
</script>
