---
import "../styles/board.css";
import {
  allJobs,
  companyJobs,
  countries,
  countryName,
  isNew,
  type JobRecord,
  salaryText,
  tzFits,
} from "../data";
import { formatDate, href, labels, languageName, type Lang, tr, type Verdict } from "../i18n";
import Avatar from "./Avatar.astro";
import Lamp from "./Lamp.astro";

interface Props {
  job: JobRecord;
  lang: Lang;
}
const { job, lang } = Astro.props;
const SOURCES: Record<string, string> = {
  greenhouse: "Greenhouse",
  lever: "Lever",
  ashby: "Ashby",
  smartrecruiters: "SmartRecruiters",
};
const open = (j: JobRecord) => Object.values(j.verdicts).some((x) => x.v !== "unclear");
const firstCountry = countries.find((c) => job.verdicts[c.code]) ?? countries[0];
const salary = salaryText(job.salary, lang);
const tzLine = job.tz
  ? [
      job.tz[2] ?? "",
      ...countries
        .map((c) => [c, tzFits(job.tz, c.code)] as const)
        .filter(([, fit]) => fit !== null)
        .map(([c, fit]) =>
          tr(lang, fit ? "tz_fits" : "tz_misses", {
            country: countryName(c, lang),
            offset: c.utc_offset >= 0 ? `+${c.utc_offset}` : `${c.utc_offset}`,
          }),
        ),
    ]
      .filter(Boolean)
      .join(" · ")
  : "";
const seniority =
  job.seniority !== "unclear" ? labels.seniority[job.seniority as keyof typeof labels.seniority]?.[lang] : "";
const engagement =
  job.engagement !== "unclear"
    ? labels.engagement[job.engagement as keyof typeof labels.engagement]?.[lang]
    : "";
const details: [string, string][] = [
  [tr(lang, "d_location"), job.location],
  [tr(lang, "d_workplace"), tr(lang, `workplace_${job.workplace}` as never)],
  [
    tr(lang, "d_contract"),
    [engagement, job.contract.replace(/([a-z])([A-Z])/g, "$1 $2").replace(/_/g, " ")]
      .filter(Boolean)
      .join(" · "),
  ],
  [tr(lang, "d_level"), seniority ?? ""],
  [tr(lang, "d_field"), labels.family[job.family as keyof typeof labels.family]?.[lang] ?? ""],
  [tr(lang, "d_languages"), job.languages.map((l) => languageName(l, lang)).join(", ")],
  [tr(lang, "d_salary"), salary],
  [tr(lang, "d_timezone"), tzLine],
  [tr(lang, "d_department"), job.department],
  [tr(lang, "d_source"), SOURCES[job.source] ?? job.source],
  [tr(lang, "d_first_seen"), formatDate(job.seen, lang, true)],
].filter(([, v]) => v) as [string, string][];

const atCompany = companyJobs(job.company_key).filter((j) => j.id !== job.id && open(j));
const similar = allJobs
  .filter((j) => j.id !== job.id && j.family === job.family && j.company_key !== job.company_key && open(j))
  .sort((a, b) => b.seen_at.localeCompare(a.seen_at))
  .slice(0, 5);
const named = [...new Set(companyJobs(job.company_key).flatMap((j) => j.named))].filter((c) =>
  countries.some((x) => x.code === c),
);
const verdictOf = (code: string): Verdict | null => job.verdicts[code]?.v ?? null;
---

<div class="wrap job-page" data-job-id={job.id}>
  <nav class="crumbs">
    <a href={href(lang, "country", firstCountry.code)}
      >← {tr(lang, "back_to_jobs", { country: countryName(firstCountry, lang) })}</a
    >
  </nav>

  <header class="jp-head">
    <Avatar name={job.company} companyKey={job.company_key} size={56} />
    <div>
      <h1>{job.title}</h1>
      <p class="jp-company">
        <a href={href(lang, "company", job.company_key)}>{job.company}</a>
        {isNew(job.seen_at) && <span class="new-badge">{tr(lang, "new_badge")}</span>}
      </p>
    </div>
  </header>

  <div class="jp-actions">
    <a class="btn btn-primary" href={job.url} target="_blank" rel="noopener noreferrer">
      {tr(lang, "apply")}
      <span class="sr-only">{tr(lang, "apply_sr")}</span>
      <svg width="14" height="14" viewBox="0 0 14 14" fill="none" aria-hidden="true">
        <path d="M5 2.5h6.5V9M11.5 2.5 3 11" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"></path>
      </svg>
    </a>
    <button type="button" class="btn btn-secondary save-btn" data-save={job.id} aria-pressed="false">
      <svg width="16" height="16" viewBox="0 0 16 16" aria-hidden="true">
        <path d="M8 1.8l1.9 3.9 4.3.6-3.1 3 .7 4.3L8 11.6l-3.8 2 .7-4.3-3.1-3 4.3-.6z" fill="currentColor"></path>
      </svg>
      <span data-save-label data-on={tr(lang, "saved")} data-off={tr(lang, "save")}>{tr(lang, "save")}</span>
    </button>
  </div>

  <div class="jp-grid">
    <div class="jp-main">
      <section class="panel" aria-labelledby="who">
        <h2 id="who">{tr(lang, "who_can_apply")}</h2>
        <ul class="jp-verdicts">
          {
            countries.map((c) => {
              const v = verdictOf(c.code);
              return (
                <li class={v ? `v-${v}` : "v-none"}>
                  <span class="jp-country">
                    <a href={href(lang, "country", c.code)}>{countryName(c, lang)}</a>
                  </span>
                  {v ? (
                    <>
                      <span class="verdict-tag">
                        <Lamp verdict={v} />
                        {labels.verdict[v][lang]}
                      </span>
                      <span class="jp-reason">{job.verdicts[c.code].reason[lang]}</span>
                    </>
                  ) : (
                    <span class="jp-reason">
                      {tr(lang, "not_shown", { country: lang === "fr" ? c.fr_en : countryName(c, lang) })}
                    </span>
                  )}
                </li>
              );
            })
          }
        </ul>
        {
          job.quote && (
            <figure class="quote jp-quote">
              <figcaption>{tr(lang, "evidence")}</figcaption>
              <blockquote lang="und">
                <p>{job.quote}</p>
              </blockquote>
            </figure>
          )
        }
      </section>

      <section class="panel" aria-labelledby="det">
        <h2 id="det">{tr(lang, "details")}</h2>
        <dl class="jp-details">
          {
            details.map(([k, v]) => (
              <div>
                <dt>{k}</dt>
                <dd>{v}</dd>
              </div>
            ))
          }
        </dl>
      </section>
    </div>

    <aside class="jp-side">
      <a class="panel jp-guide" href={`${href(lang, "guide")}#${firstCountry.code.toLowerCase()}`}>
        {tr(lang, "guide_cta", { country: countryName(firstCountry, lang), country_en: firstCountry.fr_en })} →
      </a>
      {
        named.length > 0 && (
          <p class="panel jp-hires">
            {tr(lang, "hires_here", {
              countries: named
                .map((c) => countryName(countries.find((x) => x.code === c)!, lang))
                .join(", "),
            })}
          </p>
        )
      }
      {
        atCompany.length > 0 && (
          <section class="panel">
            <h2>{tr(lang, "more_at", { company: job.company })}</h2>
            <ul class="jp-links">
              {atCompany.slice(0, 6).map((j) => (
                <li>
                  <a href={href(lang, "job", j.slug)}>{j.title}</a>
                </li>
              ))}
            </ul>
          </section>
        )
      }
      {
        similar.length > 0 && (
          <section class="panel">
            <h2>{tr(lang, "similar")}</h2>
            <ul class="jp-links">
              {similar.map((j) => (
                <li>
                  <a href={href(lang, "job", j.slug)}>{j.title}</a>
                  <span>{j.company}</span>
                </li>
              ))}
            </ul>
          </section>
        )
      }
    </aside>
  </div>
  <p class="fine jp-disclaimer">{tr(lang, "footer_disclaimer")}</p>
</div>

<script>
  import { initSaveButtons } from "../scripts/saved";
  initSaveButtons();
</script>

<style>
  .job-page {
    padding-block: var(--space-5) var(--space-6);
  }
  .crumbs {
    font-size: var(--step-0);
    margin-bottom: var(--space-5);
  }
  .jp-head {
    display: flex;
    gap: var(--space-4);
    align-items: center;
  }
  .jp-head h1 {
    font-size: var(--step-3);
  }
  .jp-company {
    display: flex;
    align-items: center;
    gap: var(--space-2);
    color: var(--ink-2);
    font-size: var(--step-1);
    font-weight: 600;
    margin-top: 0.2rem;
  }
  .jp-actions {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-3);
    margin: var(--space-5) 0 var(--space-6);
  }
  .jp-grid {
    display: grid;
    grid-template-columns: minmax(0, 1fr) 320px;
    gap: var(--space-6);
    align-items: start;
  }
  .jp-main,
  .jp-side {
    display: grid;
    gap: var(--space-5);
  }
  .jp-verdicts {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: var(--space-2);
  }
  .jp-verdicts li {
    display: grid;
    grid-template-columns: 7.5rem auto 1fr;
    align-items: center;
    gap: var(--space-3);
    padding: var(--space-2) 0;
    border-bottom: 1px solid var(--line);
    font-size: var(--step-0);
  }
  .jp-country {
    font-weight: 600;
  }
  .jp-reason {
    color: var(--ink-2);
  }
  .v-none .jp-reason {
    grid-column: 2 / -1;
    color: var(--ink-3);
  }
  .jp-quote {
    margin-top: var(--space-3);
  }
  .jp-quote figcaption {
    font-size: var(--step--1);
    font-weight: 600;
    color: var(--ink-2);
    margin-bottom: var(--space-1);
  }
  .jp-details {
    margin: 0;
    display: grid;
    gap: 0;
  }
  .jp-details div {
    display: grid;
    grid-template-columns: 12rem 1fr;
    gap: var(--space-3);
    padding: var(--space-2) 0;
    border-bottom: 1px solid var(--line);
    font-size: var(--step-0);
  }
  .jp-details dt {
    color: var(--ink-2);
  }
  .jp-details dd {
    margin: 0;
  }
  .jp-links {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: var(--space-3);
    font-size: var(--step-0);
  }
  .jp-links span {
    display: block;
    color: var(--ink-3);
    font-size: var(--step--1);
  }
  .jp-guide {
    font-weight: 600;
    text-decoration: none;
  }
  .jp-hires {
    font-size: var(--step-0);
    color: var(--go);
    font-weight: 600;
  }
  .jp-disclaimer {
    margin-top: var(--space-6);
  }
  @media (max-width: 980px) {
    .jp-grid {
      grid-template-columns: minmax(0, 1fr);
    }
  }
  @media (max-width: 600px) {
    .jp-verdicts li {
      grid-template-columns: 1fr auto;
    }
    .jp-verdicts .jp-reason {
      grid-column: 1 / -1;
    }
    .jp-details div {
      grid-template-columns: 1fr;
      gap: 0.1rem;
    }
  }
</style>
