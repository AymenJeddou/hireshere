---
import {
  allJobs,
  companyJobs,
  countries,
  countryName,
  isNew,
  type JobRecord,
  salaryText,
  SOURCES,
  tzFits,
} from "../data";
import { formatDate, href, labels, languageName, type Lang, tr, type Verdict } from "../i18n";
import Avatar from "./Avatar.astro";
import JobInfo from "./JobInfo.astro";
import Lamp from "./Lamp.astro";

interface Props {
  job: JobRecord;
  lang: Lang;
}
const { job, lang } = Astro.props;
const open = (j: JobRecord) => Object.values(j.verdicts).some((x) => x.v !== "unclear");
const firstCountry = countries.find((c) => job.verdicts[c.code]) ?? countries[0];
const salary = salaryText(job.salary, lang);
const tzLine = job.tz
  ? [
      job.tz[2] ?? "",
      ...countries
        .map((c) => [c, tzFits(job.tz, c.code)] as const)
        .filter(([, fit]) => fit !== null)
        .map(([c, fit]) =>
          tr(lang, fit ? "tz_fits" : "tz_misses", {
            country: countryName(c, lang),
            offset: c.utc_offset >= 0 ? `+${c.utc_offset}` : `${c.utc_offset}`,
          }),
        ),
    ]
      .filter(Boolean)
      .join(" · ")
  : "";
const seniority =
  job.seniority !== "unclear" ? labels.seniority[job.seniority as keyof typeof labels.seniority]?.[lang] : "";
const engagement =
  job.engagement !== "unclear" ? labels.engagement[job.engagement as keyof typeof labels.engagement]?.[lang] : "";
const details: [string, string][] = [
  [tr(lang, "d_location"), job.location],
  [tr(lang, "d_workplace"), tr(lang, `workplace_${job.workplace}` as never)],
  [
    tr(lang, "d_contract"),
    [engagement, job.contract.replace(/([a-z])([A-Z])/g, "$1 $2").replace(/_/g, " ")].filter(Boolean).join(" · "),
  ],
  [tr(lang, "d_level"), seniority ?? ""],
  [tr(lang, "d_field"), labels.family[job.family as keyof typeof labels.family]?.[lang] ?? ""],
  [tr(lang, "d_languages"), job.languages.map((l) => languageName(l, lang)).join(", ")],
  [tr(lang, "d_salary"), salary],
  [tr(lang, "d_timezone"), tzLine],
  [tr(lang, "d_department"), job.department],
  [tr(lang, "d_source"), SOURCES[job.source]?.name ?? job.source],
  [tr(lang, "d_first_seen"), formatDate(job.seen, lang, true)],
].filter(([, v]) => v) as [string, string][];

const atCompany = companyJobs(job.company_key).filter((j) => j.id !== job.id && open(j));
const similar = allJobs
  .filter((j) => j.id !== job.id && j.family === job.family && j.company_key !== job.company_key && open(j))
  .sort((a, b) => b.seen_at.localeCompare(a.seen_at))
  .slice(0, 5);
const named = [...new Set(companyJobs(job.company_key).flatMap((j) => j.named))].filter((c) =>
  countries.some((x) => x.code === c),
);
const verdictOf = (code: string): Verdict | null => job.verdicts[code]?.v ?? null;
const best = (j: JobRecord) =>
  (["eligible", "likely", "unclear"] as const).find((v) => Object.values(j.verdicts).some((x) => x.v === v))!;
const website = job.website ? new URL(job.website).hostname.replace(/^www\./, "") : "";
const companyOpen = companyJobs(job.company_key).length;
const vs = Object.fromEntries(Object.entries(job.verdicts).map(([c, x]) => [c, x.v]));
---

<div class="wrap job-page">
  <nav class="crumbs" aria-label="Breadcrumb">
    <a href={href(lang, "search")}>{tr(lang, "nav_find")}</a>
    <span aria-hidden="true"> <span class="flip">›</span> </span>
    <a href={href(lang, "country", firstCountry.code)}>{countryName(firstCountry, lang)}</a>
    <span aria-hidden="true"> <span class="flip">›</span> </span>
    <span aria-current="page">{job.title}</span>
  </nav>

  <div class="jp-grid">
    <div class="jp-main">
      <header class="panel jp-head">
        <Avatar name={job.company} companyKey={job.company_key} size={64} />
        <div>
          <p class="jp-company"><a href={href(lang, "company", job.company_key)}>{job.company}</a></p>
          <h1>
            {job.title}
            {isNew(job.seen_at) && <span class="new-badge">{tr(lang, "new_badge")}</span>}
          </h1>
          <JobInfo job={job} lang={lang} found />
          <div class="jp-actions">
            <a class="btn btn-primary" href={job.url} target="_blank" rel="noopener">
              {tr(lang, "apply")}
              <span class="sr-only">{tr(lang, "apply_sr")}</span>
              <svg class="icon" viewBox="0 0 24 24" aria-hidden="true"><path d="M14 4h6v6M20 4l-9 9M18 14v5a1 1 0 0 1-1 1H5a1 1 0 0 1-1-1V7a1 1 0 0 1 1-1h5"></path></svg>
            </a>
            <button type="button" class="btn btn-secondary save-btn" data-save={job.id} aria-pressed="false">
              <svg class="icon" viewBox="0 0 24 24" aria-hidden="true"><path d="M12 3.5l2.6 5.3 5.9.9-4.3 4.1 1 5.8L12 16.9 6.8 19.6l1-5.8L3.5 9.7l5.9-.9z"></path></svg>
              <span data-save-label data-on={tr(lang, "saved")} data-off={tr(lang, "save")}>{tr(lang, "save")}</span>
            </button>
          </div>
        </div>
      </header>

      <section class="panel" aria-labelledby="who">
        <h2 id="who">{tr(lang, "who_can_apply")}</h2>
        <table class="who">
          <thead>
            <tr>
              <th scope="col">{tr(lang, "country_col")}</th>
              <th scope="col">{tr(lang, "verdict_col")}</th>
              <th scope="col">{tr(lang, "why")}</th>
            </tr>
          </thead>
          <tbody>
            {
              countries.map((c) => {
                const v = verdictOf(c.code);
                return (
                  <tr>
                    <th scope="row">
                      <a href={href(lang, "country", c.code)}>{countryName(c, lang)}</a>
                    </th>
                    {v ? (
                      <>
                        <td class={`v-${v} wv`}>
                          <Lamp verdict={v} /> {labels.verdict[v][lang]}
                        </td>
                        <td>{job.verdicts[c.code].reason[lang]}</td>
                      </>
                    ) : (
                      <td colspan="2" class="muted">
                        {tr(lang, "not_shown", { country: countryName(c, lang), country_en: c.fr_en })}
                      </td>
                    )}
                  </tr>
                );
              })
            }
          </tbody>
        </table>
      </section>

      {
        job.quote && (
          <section class="panel quote" aria-labelledby="says">
            <h2 id="says">{tr(lang, "posting_says")}</h2>
            <blockquote lang="und">
              <p>{job.quote}</p>
            </blockquote>
            <p class="fine jp-note">{tr(lang, "quote_note")}</p>
          </section>
        )
      }

      <section class="panel" aria-labelledby="det">
        <h2 id="det">{tr(lang, "details")}</h2>
        <dl class="jp-details">
          {
            details.map(([k, v]) => (
              <div>
                <dt>{k}</dt>
                <dd>{v}</dd>
              </div>
            ))
          }
        </dl>
      </section>

      <details class="panel report">
        <summary>{tr(lang, "report")}</summary>
        <form class="report-form" method="post" action="/api/report" data-vs={JSON.stringify(vs)}>
          <input type="hidden" name="job" value={job.id} />
          <input type="hidden" name="verdict" value={vs[firstCountry.code] ?? ""} />
          <label class="field">
            <span>{tr(lang, "alerts_country")}</span>
            <select name="country">
              {countries.map((c) => <option value={c.code} selected={c.code === firstCountry.code}>{countryName(c, lang)}</option>)}
            </select>
          </label>
          <fieldset>
            <legend class="legend-label">{tr(lang, "report_q")}</legend>
            <label class="radio"><input type="radio" name="kind" value="wrong_verdict" required />{tr(lang, "report_wrong")}</label>
            <label class="radio"><input type="radio" name="kind" value="closed" />{tr(lang, "report_closed")}</label>
            <label class="radio"><input type="radio" name="kind" value="other" />{tr(lang, "report_info")}</label>
          </fieldset>
          <label class="field">
            <span>{tr(lang, "report_note")}</span>
            <textarea name="note" maxlength="500" rows="2"></textarea>
          </label>
          <div>
            <button class="btn btn-secondary" type="submit" data-sending={tr(lang, "sending")} data-ok={tr(lang, "report_sent")} data-err={tr(lang, "report_failed")}>
              {tr(lang, "report_send")}
            </button>
          </div>
          <p class="form-msg" role="status" aria-live="polite"></p>
        </form>
      </details>
    </div>

    <aside class="jp-side">
      <section class="panel">
        <div class="jp-co">
          <Avatar name={job.company} companyKey={job.company_key} size={44} />
          <div>
            <b>{job.company}</b>
            <span class="fine">{tr(lang, "open_jobs_n", { n: companyOpen })}{website && ` · ${website}`}</span>
          </div>
        </div>
        {
          named.length > 0 && (
            <p class="jp-hires">
              {tr(lang, "hires_here", {
                countries: named.map((c) => countryName(countries.find((x) => x.code === c)!, lang)).join(", "),
              })}
            </p>
          )
        }
        <a href={href(lang, "company", job.company_key)}>{tr(lang, "see_company")}</a>
      </section>
      {
        atCompany.length > 0 && (
          <section class="panel">
            <h2>{tr(lang, "more_at", { company: job.company })}</h2>
            <ul class="jp-links">
              {atCompany.slice(0, 5).map((j) => (
                <li>
                  <a href={href(lang, "job", j.slug)}>{j.title}</a>
                  <span class={`v-${best(j)}`}>
                    <Lamp verdict={best(j)} /> {labels.verdict[best(j)][lang]}
                  </span>
                </li>
              ))}
            </ul>
          </section>
        )
      }
      {
        similar.length > 0 && (
          <section class="panel">
            <h2>{tr(lang, "similar")}</h2>
            <ul class="jp-links">
              {similar.map((j) => (
                <li>
                  <a href={href(lang, "job", j.slug)}>{j.title}</a>
                  <span class={`v-${best(j)}`}>
                    {j.company} · <Lamp verdict={best(j)} /> {labels.verdict[best(j)][lang]}
                  </span>
                </li>
              ))}
            </ul>
          </section>
        )
      }
      <section class="panel jp-guide">
        <h2>{tr(lang, "guide_cta", { country: countryName(firstCountry, lang), country_en: firstCountry.fr_en })}</h2>
        <a href={`${href(lang, "guide")}#${firstCountry.code.toLowerCase()}`}>{tr(lang, "nav_guide")} <span class="flip">→</span></a>
      </section>
    </aside>
  </div>
</div>

<script>
  import { initSaveButtons } from "../scripts/saved";
  initSaveButtons();
  const f = document.querySelector<HTMLFormElement>(".report-form");
  if (f) {
    const vs = JSON.parse(f.dataset.vs ?? "{}");
    const country = f.elements.namedItem("country") as HTMLSelectElement;
    country.addEventListener("change", () => {
      (f.elements.namedItem("verdict") as HTMLInputElement).value = vs[country.value] ?? "not_eligible";
    });
    f.addEventListener("submit", async (ev) => {
      ev.preventDefault();
      if (!f.reportValidity()) return;
      const button = f.querySelector<HTMLButtonElement>("button[type=submit]")!;
      const msg = f.querySelector<HTMLElement>(".form-msg")!;
      const label = button.textContent;
      button.disabled = true;
      button.textContent = button.dataset.sending ?? "";
      try {
        const res = await fetch(f.action, { method: "POST", body: new FormData(f) });
        if (!res.ok) throw new Error(String(res.status));
        msg.className = "form-msg ok";
        msg.textContent = button.dataset.ok ?? "";
        f.querySelectorAll("fieldset, label.field, button").forEach((el) => el.remove());
      } catch {
        msg.className = "form-msg err";
        msg.textContent = button.dataset.err ?? "";
        button.disabled = false;
        button.textContent = label;
      }
    });
  }
</script>

<style>
  .job-page {
    padding-block: var(--space-4) 0;
  }
  .crumbs {
    font-size: var(--step--1);
    color: var(--ink-3);
    margin-bottom: var(--space-4);
  }
  .crumbs a {
    color: inherit;
  }
  .jp-grid {
    display: grid;
    grid-template-columns: minmax(0, 1fr) 320px;
    gap: var(--space-5);
    align-items: start;
  }
  .jp-main,
  .jp-side {
    display: grid;
    gap: var(--space-4);
  }
  .jp-head {
    display: grid;
    grid-template-columns: 64px minmax(0, 1fr);
    gap: var(--space-4);
  }
  .jp-head h1 {
    font-size: var(--step-4);
    color: var(--ink);
    line-height: 1.2;
  }
  .jp-head .new-badge {
    margin-inline-start: var(--space-2);
  }
  .jp-company {
    color: var(--ink-3);
  }
  .jp-company a {
    color: inherit;
  }
  .jp-actions {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-3);
    margin-top: var(--space-4);
  }
  .who {
    width: 100%;
    border-collapse: collapse;
    font-size: var(--step-0);
  }
  .who th,
  .who td {
    text-align: start;
    padding: var(--space-3);
    padding-inline-start: 0;
    border-bottom: 1px solid var(--line);
    vertical-align: top;
  }
  .who thead th {
    font-size: var(--step--1);
    color: var(--ink-3);
    font-weight: 500;
    padding-top: 0;
  }
  .who tbody th {
    font-weight: 500;
  }
  .who tbody th a {
    color: var(--ink);
  }
  .wv {
    white-space: nowrap;
    font-weight: 500;
    color: var(--ink);
  }
  .muted {
    color: var(--ink-3);
  }
  .jp-note {
    margin-top: var(--space-3);
  }
  .jp-details {
    margin: 0;
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: var(--space-4) var(--space-5);
  }
  .jp-details dt {
    font-size: var(--step--1);
    color: var(--ink-3);
  }
  .jp-details dd {
    margin: 0;
    color: var(--ink);
    font-weight: 500;
    overflow-wrap: anywhere;
  }
  .report summary {
    cursor: pointer;
    font-weight: 500;
    color: var(--ink);
  }
  .jp-co {
    display: flex;
    gap: var(--space-3);
    align-items: center;
    margin-bottom: var(--space-3);
  }
  .jp-co div {
    display: grid;
  }
  .jp-co b {
    color: var(--ink);
  }
  .jp-hires {
    font-size: var(--step-0);
    color: var(--go);
    margin-bottom: var(--space-3);
  }
  .jp-links {
    list-style: none;
    margin: 0;
    padding: 0;
  }
  .jp-links li {
    padding: var(--space-3) 0;
    border-top: 1px solid var(--line);
    display: grid;
    gap: 0.15rem;
  }
  .jp-links a {
    color: var(--ink);
    font-weight: 500;
  }
  .jp-links span {
    display: inline-flex;
    align-items: center;
    gap: 0.35rem;
    font-size: var(--step--1);
    color: var(--ink-3);
  }
  .jp-guide {
    background: var(--brand);
    border-color: var(--brand);
  }
  .jp-guide h2 {
    color: #fff;
  }
  .jp-guide a {
    color: #fff;
    font-weight: 700;
  }
  @media (max-width: 980px) {
    .jp-grid {
      grid-template-columns: minmax(0, 1fr);
    }
  }
  @media (max-width: 600px) {
    .jp-head {
      grid-template-columns: minmax(0, 1fr);
    }
    .jp-details {
      grid-template-columns: minmax(0, 1fr);
    }
    .jp-actions .btn {
      flex: 1;
    }
  }
</style>
