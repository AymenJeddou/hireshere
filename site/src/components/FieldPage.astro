---
import "../styles/board.css";
import { type Country, countryName, jobsFor } from "../data";
import { href, labels, type Lang, tr } from "../i18n";
import JobRow from "./JobRow.astro";

interface Props {
  country: Country;
  family: string;
  lang: Lang;
}
const { country, family, lang } = Astro.props;
const all = jobsFor(country.code).filter((j) => j.verdict !== "unclear");
const jobs = all.filter((j) => j.family === family);
const field = (labels.family[family as keyof typeof labels.family]?.[lang] ?? family).toLowerCase();
const name = countryName(country, lang);
const vars = { field, country: name, country_en: country.fr_en, n: jobs.length };
const others = Object.keys(labels.family).filter(
  (f) => f !== family && f !== "other" && all.some((j) => j.family === f),
);
---

<div class="wrap">
  <header class="page-head">
    <h1>{tr(lang, "field_title", vars)}</h1>
    <p class="sub">{tr(lang, "field_intro", vars)}</p>
  </header>
  <ol class="jobs field-jobs">
    {jobs.map((job) => <JobRow job={job} lang={lang} compact />)}
  </ol>
  <p class="field-more">
    <a class="btn btn-secondary" href={`${href(lang, "country", country.code)}?f=${family}`}>
      {tr(lang, "field_all", { n: all.length, country: name })}
    </a>
  </p>
  {
    others.length > 0 && (
      <nav class="field-nav" aria-label={tr(lang, "browse_fields")}>
        <h2>{tr(lang, "browse_fields")}</h2>
        <ul>
          {others.map((f) => (
            <li>
              <a href={href(lang, "field", `${country.code.toLowerCase()}/${f}`)}>
                {labels.family[f as keyof typeof labels.family][lang]}
              </a>
            </li>
          ))}
        </ul>
      </nav>
    )
  }
</div>

<script>
  import { initSaveButtons } from "../scripts/saved";
  initSaveButtons();
</script>

<style>
  .field-jobs {
    max-width: 880px;
  }
  .field-more {
    margin-top: var(--space-5);
  }
  .field-nav {
    margin-top: var(--space-7);
  }
  .field-nav h2 {
    font-size: var(--step-1);
    margin-bottom: var(--space-3);
  }
  .field-nav ul {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2);
  }
  .field-nav a {
    display: inline-block;
    padding: 0.45rem 0.9rem;
    border: 1px solid var(--line-2);
    border-radius: 999px;
    background: var(--surface);
    text-decoration: none;
    font-size: var(--step-0);
  }
</style>
