---
// Company mark: the real logo when we have one (public/logos/<key>.<ext>), else initials.
import { readdirSync } from "node:fs";

// Logo files fetched by `python -m pipeline.logos`, indexed once per build.
const LOGOS = new Map(
  readdirSync(`${process.cwd()}/public/logos`).map((f) => [f.replace(/\.[^.]+$/, ""), f]),
);

interface Props {
  name: string;
  companyKey: string;
  size?: number;
}
const { name, companyKey, size = 40 } = Astro.props;
const file = LOGOS.get(companyKey);
const logo = file ? `/logos/${file}` : "";
const hasLogo = Boolean(file);
const initials = name
  .replace(/[^A-Za-z0-9 ]/g, " ")
  .split(/\s+/)
  .filter(Boolean)
  .slice(0, 2)
  .map((w) => w[0].toUpperCase())
  .join("");
// Stable, muted hue per company so the initials tile is recognisable but calm.
const hue = [...companyKey].reduce((h, c) => (h * 31 + c.charCodeAt(0)) % 360, 7);
---

{
  hasLogo ? (
    <img class="avatar" src={logo} alt="" width={size} height={size} loading="lazy" decoding="async" />
  ) : (
    <span
      class="avatar avatar-initials"
      aria-hidden="true"
      style={`--size:${size}px;--hue:${hue}`}
    >
      {initials}
    </span>
  )
}
