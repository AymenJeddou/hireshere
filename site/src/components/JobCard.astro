---
// The one job card: search results, home page, company pages.
import { countries, countryName, isNew, type JobRecord, site } from "../data";
import { href, labels, type Lang, tr } from "../i18n";
import { groups, groupText, type LineText, type V } from "../verdictline";
import Avatar from "./Avatar.astro";
import JobInfo from "./JobInfo.astro";
import Lamp from "./Lamp.astro";

interface Props {
  job: JobRecord;
  lang: Lang;
  /** Countries the verdict line speaks about (default: all). */
  scope?: string[];
}
const { job, lang, scope = countries.map((c) => c.code) } = Astro.props;
const vs = Object.fromEntries(Object.entries(job.verdicts).map(([c, x]) => [c, x.v])) as Record<string, V>;
const reasons = Object.fromEntries(Object.entries(job.verdicts).map(([c, x]) => [c, x.reason[lang]]));
const t: LineText = {
  label: { eligible: labels.verdict.eligible[lang], likely: labels.verdict.likely[lang], unclear: labels.verdict.unclear[lang] },
  names: Object.fromEntries(countries.map((c) => [c.code, countryName(c, lang)])),
  inPlaces: tr(lang, "verdict_in"),
  inAll: tr(lang, "verdict_all"),
};
const present = scope.filter((c) => vs[c]);
const gs = groups(vs, present, ["eligible", "likely", "unclear"]);
const lead = gs[0];
const days = Math.max(0, Math.floor((Date.parse(site.updated) - Date.parse(job.seen_at)) / 86400000));
const found = days === 0 ? tr(lang, "found_today") : days === 1 ? tr(lang, "found_1") : tr(lang, "found_ago", { n: days });
const titleId = `t-${job.id.replace(/[^a-zA-Z0-9]/g, "-")}`;
---

<li
  class="card"
  data-id={job.id}
  data-vs={JSON.stringify(vs)}
  data-r={JSON.stringify(reasons)}
  data-f={job.family}
  data-s={job.seniority}
  data-e={job.engagement}
  data-l={job.languages.join(" ")}
  data-q={`${job.title} ${job.company}`.toLowerCase()}
  data-seen={job.seen_at}
  data-days={days}
  data-sal={job.salary ? "1" : ""}
>
  <Avatar name={job.company} companyKey={job.company_key} size={52} />
  <div class="card-body">
    <p class="card-co"><a href={href(lang, "company", job.company_key)}>{job.company}</a></p>
    <h3 class="card-title" id={titleId}>
      <a href={href(lang, "job", job.slug)}>{job.title}</a>
      {isNew(job.seen_at) && <span class="new-badge">{tr(lang, "new_badge")}</span>}
    </h3>
    <JobInfo job={job} lang={lang} />
    <p class="card-verdict" data-line>
      {
        gs.map((g) => (
          <span class={`vl v-${g.v}`}>
            <Lamp verdict={g.v} />
            {groupText(g, scope.length, t)}
          </span>
        ))
      }
      {gs.length === 1 && lead && <span class="why">{reasons[lead.codes[0]]}</span>}
    </p>
    {
      job.quote ? (
        <blockquote class="card-quote" lang="und">
          <p>{job.quote}</p>
        </blockquote>
      ) : null
    }
  </div>
  <div class="card-side">
    <button type="button" class="icon-btn save-btn" data-save={job.id} aria-pressed="false" aria-label={`${tr(lang, "save")}: ${job.title}`} aria-describedby={titleId}>
      <svg class="icon" viewBox="0 0 24 24" aria-hidden="true"><path d="M12 3.5l2.6 5.3 5.9.9-4.3 4.1 1 5.8L12 16.9 6.8 19.6l1-5.8L3.5 9.7l5.9-.9z" /></svg>
    </button>
    <time class="card-date" datetime={job.seen}>{found}</time>
  </div>
</li>
