# Copy to .env for local runs. Never commit .env.

# Path of the SQLite database (default jobs.db)
JOBS_DB=jobs.db
# Per-request network timeout in seconds (default 20)
HTTP_TIMEOUT=20

# Phase 2 classifier (Gemini). Also set GEMINI_API_KEY as a GitHub Actions secret.
GEMINI_API_KEY=
# Default gemini-3.1-flash-lite. Prices in USD per million tokens, standard tier.
# CLASSIFIER_MODEL=gemini-3.1-flash-lite
# CLASSIFIER_PRICE_IN=0.25
# CLASSIFIER_PRICE_OUT=1.50
