# Copy to .env for local runs. Never commit .env.

# Path of the SQLite database (default jobs.db)
JOBS_DB=jobs.db
# Per-request network timeout in seconds (default 20)
HTTP_TIMEOUT=20

# Phase 2 classifier (Gemini). Also set GEMINI_API_KEY as a GitHub Actions secret.
GEMINI_API_KEY=
# Default gemini-3.1-flash-lite. Prices in USD per million tokens, standard tier.
# CLASSIFIER_MODEL=gemini-3.1-flash-lite
# CLASSIFIER_PRICE_IN=0.25
# CLASSIFIER_PRICE_OUT=1.50

# Telegram channels (optional): bot from @BotFather, added as admin of each channel
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHANNELS=TN=@channel_tn:fr,MA=@channel_ma:fr,DZ=@channel_dz:fr,EG=@channel_eg:ar

# Free fallback classifier (Groq, OpenAI-compatible), used once Gemini's free daily quota is out
GROQ_API_KEY=
# GROQ_MODEL=openai/gpt-oss-120b
# Pacing for free tiers in sync mode, requests per minute (0 = none)
# GEMINI_RPM=10
# GROQ_RPM=4

# Mistral free Experiment tier (choose the plan and verify a phone in console.mistral.ai)
MISTRAL_API_KEY=
# MISTRAL_MODEL=mistral-small-latest
# MISTRAL_RPM=50
# Stop starting new classify requests after this many minutes in sync mode (0 = no limit)
# CLASSIFY_MINUTES=0

# Email alerts (Resend) and the one-click unsubscribe link. UNSUBSCRIBE_SECRET must match the
# Pages secret of the same name, or links in emails stop working.
RESEND_API_KEY=
UNSUBSCRIBE_SECRET=
# Cloudflare: reads subscribers from D1 for alerts, and deploys the site by hand
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_API_TOKEN=

# Passphrase of the encrypted jobs.db snapshot on the data-latest release (see CLAUDE.md)
DB_PASSPHRASE=
